# Guardian-AI Root .gitignore

# Python & Virtual Environments
venv/
.venv/
env/
.env/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.output/
frontend/.vinxi/
frontend/.tanstack/
frontend/.nitro/
frontend/.wrangler/
frontend/.dev.vars

# Credentials, Keys & Secrets
.env
.env.local
.env.*.local
*.key
guardianai-key.json
serviceAccountKey.json
*key*.json

# Temporary Run Files & Logs
backend/temp.jpg
temp.jpg
*.log
npm-debug.log*
yarn-debug.log*

# IDE & System Files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
