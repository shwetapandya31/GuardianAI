# Guardian-AI Backend Environment Template
# Rename this file to .env and supply configuration if needed

# Server & Streaming Configuration
FLASK_PORT=8000
CAMERA_INDEX=1

# Roboflow API Configuration (Optional Violence Detection Service)
ROBOFLOW_API_KEY=YOUR_ROBOFLOW_API_KEY_HERE
ROBOFLOW_URL=https://detect.roboflow.com/violence-detection-nbx24/1

# Firebase Service Account Credentials Path
FIREBASE_CREDENTIALS_FILE=guardianai-key.json
FIREBASE_STORAGE_BUCKET=guardianai-a57df.firebasestorage.app
